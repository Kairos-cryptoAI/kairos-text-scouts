KAIROS_BUS_BACKEND=redis
KAIROS_REDIS_URL=redis://localhost:6379/0
KAIROS_POLL_INTERVAL_S=300
KAIROS_TOP_K=5
KAIROS_MAX_EVENT_AGE_S=1800
KAIROS_MAX_FUTURE_SKEW_S=5
# Operator-provisioned SHA-256 of the immutable service/deployment/feed/account scope.
# Required for durable processing; changing it deliberately creates a new dedup namespace.
KAIROS_PROCESSING_SCOPE_SHA256=
KAIROS_X_BEARER_TOKEN=
KAIROS_X_MONTHLY_BUDGET_MICROUSD=2000000
KAIROS_X_POST_READ_UNIT_COST_MICROUSD=5000
KAIROS_X_USER_READ_UNIT_COST_MICROUSD=10000
KAIROS_DEEPSEEK_API_KEY=
